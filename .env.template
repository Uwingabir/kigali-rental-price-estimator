# ─────────────────────────────────────────────────────────────────────────────
# KigaliRent — Environment Variables Template
# Copy this file to .env and fill in your real credentials.
# Never commit .env to Git!
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio WhatsApp Credentials ──────────────────────────────────────────────
# Get these from https://console.twilio.com after signing up for a free account.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio sandbox WhatsApp number (used during testing)
# For production, replace with your approved Twilio WhatsApp sender number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Commissioner Contact ──────────────────────────────────────────────────────
# The WhatsApp number that will receive customer inquiries.
# Must include country code, e.g. Rwanda (+250): whatsapp:+250788000000
COMMISSIONER_WHATSAPP_NUMBER=whatsapp:+250788000000

# ── Commissioner Dashboard PIN ────────────────────────────────────────────────
# Simple numeric PIN to access the Commissioner Dashboard view.
COMMISSIONER_PIN=1234
